#!/bin/sh
# Regenerates stats.json + index.html's inline STATS block from real git history before every
# commit, so Velocity never goes stale. Installed via `npm run hooks:install` (git doesn't version
# .git/hooks, so this source file is the one that's tracked).
node scripts/gen-stats.mjs || exit 1
git add stats.json index.html README.md

# Advisory only (see the script's own comment) — never blocks the commit.
node scripts/check-roadmap-sync.mjs

# Advisory here, enforcing in CI (.github/workflows/ci.yml). A dead code_ref should stop
# a branch, not a local commit — the ref usually dies mid-refactor and blocking the commit
# that is fixing it is exactly backwards.
node scripts/check-flow-refs.mjs || true
